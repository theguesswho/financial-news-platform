#!/bin/bash
# Deploy-safety gate (user-approved 2026-08-09): refuse pushes while a
# scheduler run is live or a slot starts within 10 minutes.
# Override for genuine emergencies: DEPLOY_ANYWAY=1 git push
[ "$DEPLOY_ANYWAY" = "1" ] && exit 0
VENV="$(git rev-parse --show-toplevel)/venv/bin/python"
"$VENV" "$(git rev-parse --show-toplevel)/scripts/deploy_gate.py"
